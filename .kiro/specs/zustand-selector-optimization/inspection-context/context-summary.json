      "target": "electron-sdd-manager/src/remote-ui/**/*.tsx",
      "action": "UPDATE",
      "reason": "Remote UI components need selector pattern migration"
    },
    {
      "target": "electron-sdd-manager/src/shared/components/**/*.tsx",
      "action": "UPDATE",
      "reason": "Shared components need selector migration and React.memo wrapping"
