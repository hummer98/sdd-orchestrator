      "requirements": ["2.2", "2.3", "2.5"]
    },
    {
      "name": "SystemRouter",
      "type": "service",
      "path": "electron-sdd-manager/src/main/trpc/routers/system.ts",
      "requirements": ["6.1", "6.2", "6.3", "6.4"]
