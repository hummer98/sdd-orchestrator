  "impact_analysis": [
    {
      "target": "electron-sdd-manager/src/renderer/App.tsx",
      "action": "UPDATE",
      "reason": "Root component subscribes to multiple stores without selectors"
    },
    {
      "target": "electron-sdd-manager/src/renderer/components/*.tsx",
      "action": "UPDATE",
      "reason": "All renderer components need selector pattern migration"
