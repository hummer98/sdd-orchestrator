  "selector_patterns": {
    "individual": "1-2 state fields: const x = useStore(s => s.x)",
    "useShallow": "3+ state fields: const { a, b, c } = useStore(useShallow(s => ({ a: s.a, b: s.b, c: s.c })))",
    "actions_only": "Actions don't need selectors: const action = useStore(s => s.action)"
  },
  "memo_targets": [
